          </div>

          <!-- =================================================================
               แท็บที่ 9: ติดต่อเรา & แผนที่
               ================================================================= -->
          <div class="admin-tab-pane" id="tab-contact">
            <h2 class="admin-pane-title">9. ตั้งค่าข้อมูลติดต่อเรา &amp; แผนที่</h2>
            <p class="admin-pane-desc">แก้ไขที่อยู่ เบอร์โทรศัพท์ อีเมล และลิงก์นำทาง Google Maps</p>

            <form class="admin-form-box" id="form-edit-contact">
              <div class="admin-form-grid">
                <div class="admin-field">
                  <label for="contact-name">ชื่อโรงพยาบาล</label>
                  <input type="text" id="contact-name" required />
                </div>
                <div class="admin-field">
                  <label for="contact-phone">เบอร์โทรศัพท์</label>
                  <input type="text" id="contact-phone" required />
                </div>
                <div class="admin-field is-full">
                  <label for="contact-address">ที่อยู่โรงพยาบาล</label>
                  <input type="text" id="contact-address" required />
                </div>
                <div class="admin-field is-full">
                  <label for="contact-email">อีเมลติดต่อ</label>
                  <input type="email" id="contact-email" required />
                </div>
                <div class="admin-field is-full">
                  <label for="contact-map-dir">ลิงก์นำทาง Google Maps</label>
                  <input type="text" id="contact-map-dir" required />
                </div>
              </div>
              <button type="submit" class="admin-btn admin-btn-primary">บันทึกข้อมูลติดต่อเรา</button>
            </form>
          </div>

        </div>
      </div>

      <!-- Modal เปิดดูภาพขนาดใหญ่ (Image Lightbox สำหรับดูภาพปกและภาพงานทั้งหมดที่เพิ่ม) -->
      <div class="ksp-modal-backdrop" id="admin-lightbox-backdrop" role="dialog" aria-modal="true" aria-labelledby="admin-lightbox-title">
        <div class="ksp-modal-dialog" style="max-width:920px;">
          <div class="ksp-modal-header">
            <div>
              <span class="ksp-modal-badge" id="admin-lightbox-badge">ตรวจสอบความคมชัดรูปภาพ (HD Image Viewer)</span>
              <h3 class="ksp-modal-title" id="admin-lightbox-title">ดูรูปภาพขนาดเต็ม</h3>
            </div>
            <button type="button" class="ksp-modal-close" id="admin-lightbox-close" aria-label="ปิดหน้าต่าง">&times;</button>
          </div>
          <div class="ksp-modal-body" id="admin-lightbox-body" style="text-align:center;"></div>
          <div class="ksp-modal-footer" id="admin-lightbox-footer">
            <button type="button" class="ksp-modal-ok-btn" id="admin-lightbox-ok">ปิดหน้าต่าง</button>
          </div>
        </div>
      </div>

      <!-- กล่องยืนยันการลบข้อมูล (Delete Confirmation Modal สวยงาม) -->
      <div class="admin-confirm-backdrop" id="admin-confirm-backdrop" style="display:none;" role="dialog" aria-modal="true">
        <div class="admin-confirm-dialog">
          <div class="admin-confirm-icon-wrap" id="admin-confirm-icon-wrap">🗑️</div>
          <h3 class="admin-confirm-title" id="admin-confirm-title">ยืนยันการลบข้อมูล</h3>
          <p class="admin-confirm-text" id="admin-confirm-desc">คุณแน่ใจหรือไม่ว่าต้องการลบรายการนี้?</p>
          <div class="admin-confirm-actions">
            <button type="button" class="admin-btn admin-btn-outline" id="admin-confirm-cancel">ยกเลิก</button>
            <button type="button" class="admin-btn admin-btn-danger" id="admin-confirm-ok">ยืนยันการลบ</button>
          </div>
        </div>
      </div>

    </div>
  </main>

  <!-- แถบส่วนท้ายเว็บไซต์ (Footer Bar) -->
  <div id="footer-placeholder"></div>

  <!-- โหลดข้อมูลเริ่มต้นของแต่ละส่วนเพื่อให้ระบบหลังบ้านนำไปแสดงและแก้ไขได้ทันที -->
