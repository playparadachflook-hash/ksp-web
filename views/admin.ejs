<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ระบบจัดการหลังบ้าน (Back-Office CMS) | โรงพยาบาลโคกศรีสุพรรณ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/tokens.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="stylesheet" href="/css/footer.css" />
</head>
<body>

  <!-- แถบเมนูด้านบน (Header Bar) -->
  <div id="header-placeholder"></div>

  <main id="page-content">
    <div class="admin-wrapper">

      <!-- แถบควบคุมระบบหลังบ้านด้านบน -->
      <div class="admin-topbar">
        <div class="admin-topbar-left">
          <img src="/assets/images/logo-ksp.png" alt="Logo" class="admin-topbar-logo" />
          <div>
            <h1 class="admin-topbar-title">ระบบจัดการเว็บไซต์หลังบ้าน (Admin Back-Office)</h1>
            <p class="admin-topbar-sub" id="admin-welcome-user">โรงพยาบาลโคกศรีสุพรรณ — กลุ่มงานสุขภาพดิจิทัล</p>
          </div>
        </div>

        <div class="admin-topbar-actions">
          <!-- ปุ่มสถานะและอัปเดตระบบจาก GitHub (เขียว = ปัจจุบัน, เหลือง = มีอัปเดตใหม่) -->
          <button type="button" class="admin-btn admin-btn-git-update status-current" id="admin-git-update-btn" title="ตรวจสอบและอัปเดตระบบจาก GitHub">
            <span id="admin-git-status-icon">🟢</span>
            <span id="admin-git-status-text">เวอร์ชันปัจจุบัน</span>
          </button>
          <a href="/" class="admin-btn admin-btn-primary">ดูหน้าเว็บไซต์จริง &rarr;</a>
          <button type="button" class="admin-btn admin-btn-outline" id="admin-reset-all-btn">คืนค่าเริ่มต้นทั้งหมด</button>
          <button type="button" class="admin-btn admin-btn-danger" id="admin-logout-btn">ออกจากระบบ</button>
        </div>
      </div>

      <!-- กล่องแจ้งเตือนทันสมัย (Toast Notification Container สำหรับ บันทึก / แก้ไข / ลบ) -->
      <div class="admin-toast-container" id="admin-toast-container"></div>

      <!-- แถบแจ้งเตือนเมื่อกดบันทึกสำเร็จ (Fallback) -->
      <div class="admin-toast" id="admin-toast"></div>

      <!-- โครงสร้าง 2 คอลัมน์: เมนูด้านซ้าย | ฟอร์มจัดการด้านขวา -->
      <div class="admin-layout">

        <!-- เมนูเลือกส่วนที่ต้องการแก้ไข (9 เมนูครบทุกส่วน) -->
        <aside class="admin-sidebar">
          <button type="button" class="admin-nav-btn is-active" data-tab="members">1. เพิ่มสมาชิก / ผู้ใช้งาน</button>
          <button type="button" class="admin-nav-btn" data-tab="news">2. ข่าวสาร &amp; กิจกรรม (ภาพปก+ภาพงาน)</button>
          <button type="button" class="admin-nav-btn" data-tab="policies">3. ประกาศนโยบายโรงพยาบาล</button>
          <button type="button" class="admin-nav-btn" data-tab="downloads">4. ดาวน์โหลดเอกสาร (ลงไฟล์ได้)</button>
          <button type="button" class="admin-nav-btn" data-tab="slides">5. จัดการสไลด์ประกาศ (Slide Bar)</button>
          <button type="button" class="admin-nav-btn" data-tab="executive">6. ผู้บริหาร &amp; วิสัยทัศน์</button>
          <button type="button" class="admin-nav-btn" data-tab="departments">7. แผนกและคลินิก</button>
          <button type="button" class="admin-nav-btn" data-tab="intranet">8. เว็บไซต์ภายใน</button>
          <button type="button" class="admin-nav-btn" data-tab="contact">9. ติดต่อเรา &amp; แผนที่</button>
        </aside>

        <!-- พื้นที่ฟอร์มแก้ไขของแต่ละเมนู -->
        <div class="admin-content-panel">

          <!-- =================================================================
               แท็บที่ 1: เมนูเพิ่มสมาชิก / จัดการผู้ดูแลระบบ
               ================================================================= -->
          <div class="admin-tab-pane is-active" id="tab-members">
            <h2 class="admin-pane-title">1. เมนูเพิ่มสมาชิก / จัดการผู้ใช้งานระบบหลังบ้าน</h2>
            <p class="admin-pane-desc">เพิ่มหรือแก้ไขบัญชีสมาชิกสำหรับเจ้าหน้าที่โรงพยาบาลเพื่อใช้เข้าสู่ระบบจัดการเว็บไซต์</p>

            <form class="admin-form-box" id="form-add-member">
              <h3 id="member-form-title">+ เพิ่มสมาชิกใหม่</h3>
              <input type="hidden" id="member-edit-index" value="" />
              <div class="admin-form-grid">
                <div class="admin-field">
                  <label for="member-username">ชื่อผู้ใช้งาน (Username สำหรับ Login)</label>
                  <input type="text" id="member-username" placeholder="เช่น staff01" required />
                </div>
                <div class="admin-field">
                  <div style="display:flex;justify-content:space-between;align-items:center;">
                    <label for="member-password" style="margin-bottom:0;">รหัสผ่าน (Password)</label>
                    <button type="button" id="btn-random-member-pass" title="สุ่มรหัสผ่านใหม่ที่มีอักขระพิเศษปลอดภัยสูง" style="background:none;border:none;color:#0f766e;font-size:0.8rem;font-weight:600;cursor:pointer;padding:0;display:inline-flex;align-items:center;gap:4px;">
                      🎲 สุ่มรหัสผ่านอักขระพิเศษ
                    </button>
                  </div>
                  <div style="position:relative;display:flex;align-items:center;margin-top:4px;">
                    <input type="password" id="member-password" placeholder="•••••••••••• (สุ่มอักขระพิเศษแทนรหัสจริง)" autocomplete="new-password" required style="width:100%;padding-right:38px;" />
                    <button type="button" id="btn-toggle-member-pass" title="สลับการมองเห็นรหัสผ่าน" style="position:absolute;right:10px;background:none;border:none;cursor:pointer;color:#64748b;font-size:1rem;line-height:1;padding:0;">
                      👁️
                    </button>
                  </div>
                </div>
                <div class="admin-field">
                  <label for="member-fullname">ชื่อ-นามสกุล สมาชิก</label>
                  <input type="text" id="member-fullname" placeholder="กรอกชื่อ-นามสกุลจริง" required />
                </div>
                <div class="admin-field">
                  <label for="member-role">กลุ่มงาน / สิทธิ์การใช้งาน</label>
                  <select id="member-role">
                    <option value="ผู้ดูแลระบบ (Admin)">ผู้ดูแลระบบ (Admin)</option>
                    <option value="กลุ่มงานสุขภาพดิจิทัล">กลุ่มงานสุขภาพดิจิทัล</option>
                    <option value="เจ้าหน้าที่ประชาสัมพันธ์">เจ้าหน้าที่ประชาสัมพันธ์</option>
                    <option value="งานบริหารทั่วไป/สารบรรณ">งานบริหารทั่วไป/สารบรรณ</option>
                  </select>
                </div>
              </div>
              <div style="display:flex;gap:10px;align-items:center;">
                <button type="submit" class="admin-btn admin-btn-primary" id="member-submit-btn">บันทึกสมาชิกใหม่</button>
                <button type="button" class="admin-btn admin-btn-outline" id="member-cancel-btn" style="display:none;">ยกเลิกการแก้ไข</button>
              </div>
            </form>

            <div class="admin-items-list" id="admin-members-list"></div>
          </div>

          <!-- =================================================================
               แท็บที่ 2: จัดการข่าวสาร & กิจกรรม (ใส่ภาพปก + ใส่ภาพงานทั้งหมด)
               ================================================================= -->
          <div class="admin-tab-pane" id="tab-news">
            <h2 class="admin-pane-title">2. จัดการข่าวสาร &amp; กิจกรรม (ใส่ภาพปก &amp; ภาพงานทั้งหมด)</h2>
            <p class="admin-pane-desc">ทุกครั้งที่เพิ่มภาพปกและภาพงาน ระบบ JavaScript จะปรับขนาดและเพิ่มความคมชัด (HD Sharpening) ให้อัตโนมัติ พร้อมคลิกดูภาพขยายใหญ่ได้ทันที</p>

            <form class="admin-form-box" id="form-add-news">
              <h3 id="news-form-title">+ เพิ่มข่าวสาร/กิจกรรมใหม่</h3>
              <input type="hidden" id="news-edit-index" value="" />
              <div class="admin-form-grid">
                <div class="admin-field is-full">
                  <label for="news-title">หัวข้อข่าวสาร / ชื่อกิจกรรม</label>
                  <input type="text" id="news-title" placeholder="กรอกหัวข้อข่าวสารหรือกิจกรรม" required />
                </div>
                <div class="admin-field">
                  <label for="news-cover-file">1. เลือกรูปภาพปกข่าว (JavaScript ปรับขนาดและความคมชัด HD อัตโนมัติ)</label>
                  <input type="file" id="news-cover-file" accept="image/*" />
                  <!-- กล่องพรีวิวภาพปกที่ผ่านการปรับความคมชัดแล้ว (คลิกเพื่อดูภาพใหญ่ได้) -->
                  <div class="admin-img-preview-box" id="news-cover-preview-box" style="display:none;">
                    <div class="admin-img-preview-badge" id="news-cover-status">✓ ปรับขนาดภาพปกและความคมชัด HD เรียบร้อย (คลิกที่ภาพเพื่อขยายดู)</div>
                    <img id="news-cover-preview-img" src="" alt="พรีวิวภาพปกข่าว" class="admin-cover-preview-thumb" title="คลิกเพื่อดูภาพปกขนาดใหญ่" />
                  </div>
                </div>
                <div class="admin-field">
                  <label for="news-gallery-files">2. เลือกรูปภาพงานทั้งหมด (เลือกได้หลายรูป + คลิกดูภาพที่เพิ่มได้)</label>
                  <input type="file" id="news-gallery-files" accept="image/*" multiple />
                  <!-- กล่องพรีวิวภาพงานทั้งหมด (คลิกดูทีละภาพได้) -->
                  <div class="admin-img-preview-box" id="news-gallery-preview-box" style="display:none;">
                    <div class="admin-img-preview-badge" id="news-gallery-status">✓ ภาพงานทั้งหมด (คลิกที่รูปเพื่อดูภาพขยายใหญ่)</div>
                    <div class="admin-gallery-preview-grid" id="news-gallery-preview-grid"></div>
                  </div>
                </div>
                <div class="admin-field is-full">
                  <label for="news-excerpt">รายละเอียดเนื้อหาข่าว</label>
                  <textarea id="news-excerpt" rows="3" placeholder="กรอกรายละเอียดเนื้อหาข่าวสารและกิจกรรม" required></textarea>
                </div>
              </div>
              <div style="display:flex;gap:10px;align-items:center;">
                <button type="submit" class="admin-btn admin-btn-primary" id="news-submit-btn">บันทึกข่าวสารพร้อมอัลบั้มภาพงาน</button>
                <button type="button" class="admin-btn admin-btn-outline" id="news-cancel-btn" style="display:none;">ยกเลิกการแก้ไข</button>
              </div>
            </form>

            <div class="admin-items-list" id="admin-news-list"></div>
          </div>

          <!-- =================================================================
               แท็บที่ 3: จัดการประกาศนโยบายโรงพยาบาล (เพิ่มไฟล์เอกสาร/รูปภาพได้ + วันที่ลงประกาศ + จำนวนคนเข้าดู)
               ================================================================= -->
          <div class="admin-tab-pane" id="tab-policies">
            <h2 class="admin-pane-title">3. จัดการประกาศนโยบายโรงพยาบาล</h2>
            <p class="admin-pane-desc">แนบไฟล์เอกสาร (PDF/Word) หรือรูปภาพประกาศ เพื่อให้ผู้ชมกดเข้าดูและดาวน์โหลดเอกสารหรือรูปภาพจากหน้าเว็บได้ทันที</p>

            <form class="admin-form-box" id="form-add-policy">
              <h3 id="policy-form-title">+ เพิ่มประกาศนโยบายใหม่</h3>
              <input type="hidden" id="policy-edit-index" value="" />
              <div class="admin-form-grid">
                <div class="admin-field is-full">
                  <label for="policy-title">หัวข้อประกาศนโยบายโรงพยาบาล</label>
                  <input type="text" id="policy-title" placeholder="เช่น แนวทางการตรวจห้องปฏิบัติการอย่างสมเหตุผล" required />
                </div>
                <div class="admin-field">
                  <label for="policy-file">1. แนบไฟล์เอกสารประกาศ (PDF / Word / Excel)</label>
                  <input type="file" id="policy-file" accept=".pdf,.doc,.docx,.xls,.xlsx,image/*" />
                </div>
                <div class="admin-field">
                  <label for="policy-image-file">2. แนบรูปภาพใบประกาศ (PNG / JPG — ใช้ดาวน์โหลดเป็นรูปภาพได้)</label>
                  <input type="file" id="policy-image-file" accept="image/*" />
                  <div class="admin-img-preview-box" id="policy-img-preview-box" style="display:none;">
                    <div class="admin-img-preview-badge">✓ พรีวิวรูปภาพประกาศ (คลิกที่รูปเพื่อดูภาพขยายใหญ่)</div>
                    <img id="policy-img-preview" src="" alt="พรีวิวรูปประกาศ" class="admin-cover-preview-thumb" />
                  </div>
                </div>
                <div class="admin-field">
                  <label for="policy-date">วันที่ลงประกาศ</label>
                  <input type="text" id="policy-date" value="30 ต.ค. 2569" required />
                </div>
                <div class="admin-field">
                  <label for="policy-badge">ป้ายหมวดหมู่</label>
                  <input type="text" id="policy-badge" value="ประกาศนโยบายโรงพยาบาล" required />
                </div>
                <div class="admin-field is-full">
                  <label for="policy-views">จำนวนคนที่เข้าดูเริ่มต้น (ระบบจะบวกเพิ่ม +1 อัตโนมัติเมื่อมีคนกดดู)</label>
                  <input type="number" id="policy-views" value="0" min="0" required />
                </div>
              </div>
              <div style="display:flex;gap:10px;align-items:center;">
                <button type="submit" class="admin-btn admin-btn-primary" id="policy-submit-btn">บันทึกประกาศนโยบายใหม่</button>
                <button type="button" class="admin-btn admin-btn-outline" id="policy-cancel-btn" style="display:none;">ยกเลิกการแก้ไข</button>
              </div>
            </form>

            <div class="admin-items-list" id="admin-policy-list"></div>
          </div>

          <!-- =================================================================
               แท็บที่ 4: จัดการดาวน์โหลดเอกสาร (อัปโหลดไฟล์เอกสารได้จริง)
               ================================================================= -->
          <div class="admin-tab-pane" id="tab-downloads">
            <h2 class="admin-pane-title">4. จัดการดาวน์โหลดเอกสาร (ลงไฟล์เอกสารได้จริง)</h2>
            <p class="admin-pane-desc">อัปโหลดไฟล์เอกสารเพื่อให้ประชาชนหรือเจ้าหน้าที่กดดาวน์โหลดจากหน้าเว็บไซต์ได้โดยตรง</p>

            <form class="admin-form-box" id="form-add-download">
              <h3 id="dl-form-title">+ ลงไฟล์เอกสารดาวน์โหลดใหม่</h3>
              <input type="hidden" id="dl-edit-index" value="" />
              <div class="admin-form-grid">
                <div class="admin-field is-full">
                  <label for="dl-title">ชื่อเอกสาร / แบบฟอร์ม</label>
                  <input type="text" id="dl-title" placeholder="กรอกชื่อเอกสารสำหรับดาวน์โหลด" required />
                </div>
                <div class="admin-field is-full">
                  <label for="dl-file">เลือกไฟล์เอกสารจากเครื่องคอมพิวเตอร์ (PDF, DOCX, XLSX, รูปภาพ)</label>
                  <input type="file" id="dl-file" accept=".pdf,.doc,.docx,.xls,.xlsx,image/*" />
                </div>
                <div class="admin-field">
                  <label for="dl-category">หมวดหมู่เอกสาร</label>
                  <select id="dl-category">
                    <option value="ผู้รับบริการ">ผู้รับบริการ</option>
                    <option value="เอกสารราชการ/จัดซื้อจัดจ้าง">เอกสารราชการ/จัดซื้อจัดจ้าง</option>
                    <option value="คู่มือประชาชน">คู่มือประชาชน</option>
                  </select>
                </div>
                <div class="admin-field">
                  <label for="dl-type">ชนิดไฟล์ (ระบบตรวจจับให้อัตโนมัติเมื่อเลือกไฟล์)</label>
                  <select id="dl-type">
                    <option value="PDF">PDF</option>
                    <option value="DOCX">DOCX</option>
                    <option value="XLSX">XLSX</option>
                    <option value="IMAGE">IMAGE</option>
                  </select>
                </div>
                <div class="admin-field">
                  <label for="dl-size">ขนาดไฟล์ (คำนวณอัตโนมัติเมื่อเลือกไฟล์)</label>
                  <input type="text" id="dl-size" value="250 KB" required />
                </div>
                <div class="admin-field">
                  <label for="dl-date">วันที่ลงเอกสาร</label>
                  <input type="text" id="dl-date" value="30 ต.ค. 2569" required />
                </div>
              </div>
              <div style="display:flex;gap:10px;align-items:center;">
                <button type="submit" class="admin-btn admin-btn-primary" id="dl-submit-btn">บันทึกและอัปโหลดเอกสาร</button>
                <button type="button" class="admin-btn admin-btn-outline" id="dl-cancel-btn" style="display:none;">ยกเลิกการแก้ไข</button>
              </div>
            </form>

            <div class="admin-items-list" id="admin-downloads-list"></div>
          </div>

          <!-- =================================================================
               แท็บที่ 5: จัดการสไลด์ประกาศ
               ================================================================= -->
          <div class="admin-tab-pane" id="tab-slides">
            <h2 class="admin-pane-title">5. จัดการสไลด์ประกาศ (Slide Bar / แบนเนอร์หน้าแรก)</h2>
            <p class="admin-pane-desc">เพิ่ม, แก้ไข, จัดลำดับ หรือลบรูปภาพสไลด์ประกาศและแบนเนอร์ประชาสัมพันธ์หน้าแรกของโรงพยาบาล</p>

            <form class="admin-form-box" id="form-add-slide">
              <h3 id="slide-form-title">+ เพิ่มสไลด์ประกาศใหม่</h3>
              <input type="hidden" id="slide-edit-index" value="" />
              <div class="admin-form-grid">
                <div class="admin-field">
                  <label for="slide-category">หมวดหมู่สไลด์</label>
                  <input type="text" id="slide-category" placeholder="เช่น ประกาศคลินิกเฉพาะทาง / งานสิ่งพิมพ์" required />
                </div>
                <div class="admin-field">
