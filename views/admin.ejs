  <script src="/js/policy-section.js"></script>
  <script src="/js/downloads-section.js"></script>
  <script src="/js/intranet-section.js"></script>
  <script src="/js/contact-section.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/footer.js"></script>
</body>
