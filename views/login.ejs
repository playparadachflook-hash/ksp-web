<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>เข้าสู่ระบบจัดการหลังบ้าน | โรงพยาบาลโคกศรีสุพรรณ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/tokens.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/login.css" />
  <link rel="stylesheet" href="/css/footer.css" />
</head>
<body>

  <!-- ดึง Header Bar ตัวเดียวกันจาก /js/header.js -->
  <div id="header-placeholder"></div>

  <!-- กล่องเข้าสู่ระบบหลังบ้าน -->
  <main id="page-content">
    <section class="login-section">
      <div class="login-card">
        <div class="login-brand">
          <img src="/assets/images/logo-ksp.png" alt="โลโก้ รพ.โคกศรีสุพรรณ" class="login-logo" />
          <h1 class="login-title">ระบบจัดการเว็บไซต์หลังบ้าน</h1>
          <p class="login-subtitle">โรงพยาบาลโคกศรีสุพรรณ (กลุ่มงานสุขภาพดิจิทัล)</p>
        </div>

        <form class="login-form" id="ksp-login-form" autocomplete="off">
          <div class="login-error" id="login-error-box"></div>

          <div class="login-field">
            <label for="login-username" class="login-label">ชื่อผู้ใช้งาน (Username)</label>
            <input
              type="text"
              id="login-username"
              class="login-input"
              placeholder="กรอกชื่อผู้ใช้งาน เช่น admin"
              autocomplete="username"
              required
              autofocus
            />
          </div>

          <div class="login-field">
            <label for="login-password" class="login-label">รหัสผ่าน (Password)</label>
            <div style="position:relative;display:flex;align-items:center;">
              <input
                type="password"
                id="login-password"
                class="login-input"
                placeholder="•••••••••••• (อักขระพิเศษสุ่มแทนรหัสจริง)"
                autocomplete="current-password"
                required
                style="width:100%;padding-right:38px;"
              />
              <button type="button" id="btn-toggle-login-pass" title="สลับการมองเห็นรหัสผ่าน" style="position:absolute;right:12px;background:none;border:none;cursor:pointer;color:#64748b;font-size:1.05rem;line-height:1;padding:0;">
                👁️
              </button>
            </div>
          </div>

          <button type="submit" class="login-submit-btn" id="login-submit-btn">เข้าสู่ระบบจัดการเว็บไซต์</button>
        </form>

        <div class="login-hint-box">
          <strong>ระบบความปลอดภัยการเข้าสู่ระบบ:</strong><br />
          ชื่อผู้ใช้: <code>admin</code> &nbsp;|&nbsp; รหัสผ่าน: <code style="letter-spacing:2px;font-weight:700;color:#0f766e;">*#@!&$%~</code> (รหัสผ่านความปลอดภัยสูง)
        </div>
      </div>
    </section>
  </main>

  <!-- Modal ป๊อปอัปแสดงข้อความยินดีต้อนรับผู้ใช้งาน -->
  <div class="welcome-modal-backdrop" id="welcome-modal" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="welcome-modal-card">
      <div class="welcome-icon-box">
        <svg class="welcome-check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <span class="welcome-badge">ยืนยันตัวตนสำเร็จ</span>
      <h2 class="welcome-title">ยินดีต้อนรับ</h2>
      <div class="welcome-username" id="welcome-user-name">คุณผู้ดูแลระบบ</div>
      <p class="welcome-desc">เข้าสู่ระบบจัดการเว็บไซต์หลังบ้าน โรงพยาบาลโคกศรีสุพรรณ</p>

      <div class="welcome-progress-bar">
        <div class="welcome-progress-fill" id="welcome-progress-fill"></div>
      </div>
      <div class="welcome-countdown" id="welcome-countdown">กำลังนำท่านเข้าสู่แดชบอร์ดใน 2 วินาที...</div>

      <button type="button" class="welcome-btn" id="welcome-redirect-btn">เข้าสู่แดชบอร์ดทันที &rarr;</button>
    </div>
  </div>

  <!-- ดึง Footer Bar ตัวเดียวกันจาก /js/footer.js -->
  <div id="footer-placeholder"></div>

  <script src="/js/header.js"></script>
  <script src="/js/login.js"></script>
  <script src="/js/footer.js"></script>
</body>
</html>
